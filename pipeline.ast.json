{
  "format": "mini-engine.ast",
  "version": 1,
  "nodes": [
    {
      "id": "south_orders",
      "type": "call",
      "category": "io",
      "operation": "LOAD_CSV",
      "inputs": [],
      "arguments": {
        "filepath": "data/orders_south_2018.csv"
      }
    },
    {
      "id": "central_orders",
      "type": "call",
      "category": "io",
      "operation": "LOAD_CSV",
      "inputs": [],
      "arguments": {
        "filepath": "data/Orders_Central.csv"
      }
    },
    {
      "id": "combined_orders",
      "type": "call",
      "category": "structural",
      "operation": "UNION",
      "inputs": [
        {
          "ref": "south_orders"
        },
        {
          "ref": "central_orders"
        }
      ],
      "arguments": {}
    },
    {
      "id": "normalized_segment",
      "type": "call",
      "category": "text",
      "operation": "UPPER",
      "inputs": [
        {
          "ref": "combined_orders"
        }
      ],
      "arguments": {
        "column": "Segment"
      }
    },
    {
      "id": "saved_orders",
      "type": "call",
      "category": "io",
      "operation": "SAVE_CSV",
      "inputs": [
        {
          "ref": "normalized_segment"
        }
      ],
      "arguments": {
        "filepath": "output/processed_orders.csv",
        "index": false
      }
    }
  ],
  "outputs": [
    {
      "ref": "saved_orders"
    }
  ]
}
